DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="genere-avec-node-crypto-randombytes-32-base64"
COACH_EMAIL="coach@example.com"
COACH_PASSWORD="change-moi"
# Requis sur Vercel (Auth.js derrière un proxy)
AUTH_TRUST_HOST="true"
# Fuseau horaire de l'app (dates des séances et des encaissements)
TZ="Europe/Paris"

# Hôte de la base de production : les scripts de vérification refusent de tourner dessus
PROD_DATABASE_URL_HOST=""

# Connexion Google des élèves (optionnelle : sans ces valeurs, le bouton Google est masqué)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email de contact affiché sur /confidentialite (optionnel : sans lui, on renvoie au coach).
# Une adresse dédiée au site plutôt qu'une adresse perso : la page est publique.
CONTACT_EMAIL=""
